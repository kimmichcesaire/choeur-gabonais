# ─────────────────────────────────────────────────────────
# FRONTEND — Variables d'environnement
# Copier ce fichier en .env et remplir les vraies valeurs.
# NE JAMAIS committer le fichier .env dans git.
# ─────────────────────────────────────────────────────────

# URL de l'API backend
VITE_API_URL=http://localhost:3000/api

# Supabase — https://app.supabase.com → Settings > API
# Utiliser UNIQUEMENT la clé anon (jamais la service_role côté frontend)
VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_ANON_KEY
