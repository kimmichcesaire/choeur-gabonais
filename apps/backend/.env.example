# ─────────────────────────────────────────────────────────
# BACKEND — Variables d'environnement
# Copier ce fichier en .env et remplir les vraies valeurs.
# NE JAMAIS committer le fichier .env dans git.
# ─────────────────────────────────────────────────────────

NODE_ENV=development

# Supabase — https://app.supabase.com → Settings > API
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=VOTRE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=VOTRE_SERVICE_ROLE_KEY

# Resend — https://resend.com → API Keys
RESEND_API_KEY=re_VOTRE_CLE_API

# Email admin qui reçoit les notifications
ADMIN_EMAIL=votre@email.com

# Expéditeur des emails (doit être un domaine vérifié sur Resend)
MAILER_FROM=Choeur Gabonais <noreply@votredomaine.com>

# URL du frontend (pour CORS en production)
FRONTEND_URL=https://votredomaine.com

# Port d'écoute du backend
PORT=3000
